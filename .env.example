# App
APP_ENV=development
APP_PORT=3000
IS_HTTPS=false
# Optional: set to the frontend URL to redirect after OAuth login/logout.
# Leave empty to show a backend success/logout page.
FRONTEND_URL=

# OAuth (GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:3000/api/auth/oauth/github/callback

# PostgreSQL & Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=backend-go_db
DB_SSLMODE=disable

# Auth & Session
SESSION_COOKIE_NAME=session_id
SESSION_DURATION=24h
PASSWORD_COST=10
